# Recommended Windows setup with SQL Server LocalDB
ConnectionStrings__DefaultConnection="Server=(localdb)\MSSQLLocalDB;Database=EstateIQ;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"

# If you use another SQL Server instance, replace the line above with your server name.
# Example:
# ConnectionStrings__DefaultConnection="Server=YOUR_SERVER_NAME;Database=EstateIQ;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"

# Local Redis running in Docker
Redis__ConnectionString="localhost:6379,abortConnect=false"

# Local JWT signing key. Use a different secret outside local development.
Jwt__Key="EstateIQ-Development-Jwt-Key-Replace-In-Production-2026"

# Optional SMTP email verification. Leave empty for the local demo-token fallback.
# Gmail example: use an App Password, not your normal account password.
Smtp__Host=""
Smtp__Port="587"
Smtp__Username=""
Smtp__Password=""
Smtp__FromEmail=""
Smtp__FromName="EstateIQ"
Smtp__EnableSsl="true"
Smtp__FrontendBaseUrl="http://localhost:5173"
